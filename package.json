    "verify:afinacion-words": "tsx --tsconfig tsconfig.scripts.json scripts/verify-afinacion-words.mts",
    "verify:afinacion-notes": "tsx --tsconfig tsconfig.scripts.json scripts/verify-afinacion-notes.mts",
    "verify:fcr-template": "tsx scripts/verify-fcr-template.mts",
    "verify:review-round": "tsx --tsconfig tsconfig.scripts.json scripts/verify-review-round.mts",
    "verify:alignment-keep": "tsx --tsconfig tsconfig.scripts.json scripts/verify-alignment-keep.mts",
