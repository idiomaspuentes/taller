    "@usfm-tools/usfm-readonly-react": "file:../usfm-ast/packages/usfm-readonly-react",
    "@usfm-tools/usj-core": "file:../usfm-ast/packages/usfm-usj-core",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.33.1",
    "lucide-react": "^1.41.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "overrides": {
