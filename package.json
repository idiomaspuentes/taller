{
  "name": "gateway-tasks",
  "version": "0.1.0",
  "private": true,
  "description": "TAS — Translation Assistance System: inventario, tareas y publicación de subtareas en DCS.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4175 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "languages:fetch": "tsx scripts/fetch-door43-languages.mts",
    "verify:persist": "tsx scripts/verify-assignments-persist.mts",
    "verify:prep": "tsx scripts/verify-prep.mts",
    "verify:seqmatch": "tsx scripts/verify-seqmatch.mts",
    "verify:status": "tsx scripts/verify-status.mts",
    "verify:step-claim": "tsx scripts/verify-step-claim.mts",
    "verify:portion-pr": "tsx scripts/verify-portion-pr.mts",
    "verify:book-bootstrap": "tsx scripts/verify-book-bootstrap.mts",
    "verify:usfm-merge": "tsx scripts/verify-usfm-merge.mts",
    "verify:conversation": "tsx scripts/verify-conversation.mts",
    "verify:qa-admin": "tsx scripts/verify-qa-admin.mts",
    "verify:principal-pass": "tsx scripts/verify-principal-pass.mts",
    "verify:release": "tsx scripts/verify-release.mts",
    "verify:publish-sync": "tsx scripts/verify-publish-sync.mts",
    "verify:ui-copy": "tsx scripts/verify-ui-copy.mts",
    "verify:afinacion-selection": "tsx --tsconfig tsconfig.scripts.json scripts/verify-afinacion-selection.mts",
    "verify:afinacion-store": "tsx --tsconfig tsconfig.scripts.json scripts/verify-afinacion-store.mts",
    "verify:alignment-boxes": "tsx --tsconfig tsconfig.scripts.json scripts/verify-alignment-boxes.mts",
    "mock:door43": "node scripts/mock-door43/server.mjs",
    "verify:source-package": "tsx --tsconfig tsconfig.scripts.json scripts/verify-source-package.mts",
    "verify:alignment-gloss": "tsx --tsconfig tsconfig.scripts.json scripts/verify-alignment-gloss.mts",
