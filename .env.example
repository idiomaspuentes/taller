# Address of the push Worker (push-worker/). Leave empty to turn push notices off.
VITE_PUSH_URL=

# Address of the presence relay (usfm-ast packages/usfm-relay-server), e.g. wss://tas-relay.example.workers.dev.
# Leave empty: nobody is shown as being in a subtask, and Taller works the same.
VITE_PRESENCE_URL=
